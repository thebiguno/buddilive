<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="src"/>
	<classpathentry combineaccessrules="false" kind="src" path="/ca.digitalcave.moss.restlet"/>
	<classpathentry kind="con" path="org.eclipse.jst.j2ee.internal.web.container"/>
	<classpathentry kind="con" path="org.eclipse.jst.j2ee.internal.module.container"/>
	<classpathentry kind="lib" path="WebContent/WEB-INF/classes"/>
	<classpathentry kind="lib" path="lib/derby-10.17.1.0.jar"/>
	<classpathentry kind="lib" path="lib/derbyshared-10.17.1.0.jar"/>
	<classpathentry kind="lib" path="lib/derbytools-10.17.1.0.jar"/>
	<classpathentry kind="lib" path="lib/jakarta.servlet-api-6.0.0.jar"/>
	<classpathentry kind="lib" path="lib/jetty-ee-webapp-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-ee10-servlet-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-ee10-webapp-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-http-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-io-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-security-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-server-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-session-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-util-12.1.15.jar"/>
	<classpathentry kind="lib" path="lib/jetty-xml-12.1.15.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="build/classes"/>
</classpath>
